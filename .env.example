# Окружение: local | dev | production
ENV=local

# Токен бота от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Речевой провайдер Deepgram (Nova-2 STT - основной)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Ключи AI-провайдеров (можно указать несколько через запятую для ротации)
GROQ_API_KEYS=gsk_key1,gsk_key2
DEEPSEEK_API_KEYS=crs_key1,crs_key2
DEEPSEEK_BASE_URL=https://crassusmarket.xyz
DEEPSEEK_MODEL=gpt-6.1-terra

# Опциональный прокси для доступа к AI API (http / https / socks5 / socks5h)
PROXY_URL=http://user:pass@host:port

# Настройки БД для продакшена (генерируй пароли без спецсимволов URL: openssl rand -hex 24)
POSTGRES_USER=tg_mentor_app
POSTGRES_PASSWORD=change_me_to_random_hex_password
POSTGRES_DB=tg_mentor
REDIS_PASSWORD=change_me_to_random_hex_password
